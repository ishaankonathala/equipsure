# Application runtime environment
APP_ENV=development

# Allowed CORS origins (comma-separated for multiple)
CORS_ORIGINS=http://localhost:5173

# AI provider selection and credentials (GEMINI_API_KEY left blank intentionally)
AI_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash

# PostgreSQL (Docker)
POSTGRES_USER=equipsure
POSTGRES_PASSWORD=change_me_locally
POSTGRES_DB=equipsure
POSTGRES_PORT=5432
# Authentication
JWT_SECRET=
JWT_ALGORITHM=HS256
ACCESS_TOKEN_MINUTES=60
# Seed data passwords
SEED_POLICYHOLDER_PASSWORD=
SEED_OPS_PASSWORD=
SEED_ADMIN_PASSWORD=

# Document storage
STORAGE_DIR=storage
MAX_UPLOAD_BYTES=10485760
ALLOWED_UPLOAD_TYPES=application/pdf,image/jpeg,image/png
